    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^5.0.0"
