PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# Path to the built frontend (apps/web/dist), relative to apps/api. Only used
# in production — the API serves it as static files plus an SPA fallback for
# any non-/api route. Leave unset in local dev (Vite's own dev server + proxy
# handles the frontend instead).
WEB_DIST_PATH=../web/dist
# Comma-separated origins allowed to open a realtime WebSocket connection.
# Defaults to the Vite dev server's origin (http://localhost:5173). When
# serving the built frontend from this same server (WEB_DIST_PATH set, e.g.
# for the Playwright E2E suite in e2e/), the browser's origin is this
# server's own origin instead — set this to match, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000

