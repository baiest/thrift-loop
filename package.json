{
  "name": "thrift-loop",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:commits": "tsx scripts/check-commit-msg.ts --range",
    "check:commits:history": "tsx scripts/check-commit-msg.ts --last 50",
    "check:eol": "tsx scripts/check-eol.ts",
    "build:shared": "npm run build --workspace=packages/shared --if-present",
    "typecheck": "tsx scripts/run-workspace-script.ts typecheck && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx scripts/run-workspace-script.ts test",
    "test:cov": "tsx scripts/run-workspace-script.ts test:cov",
    "build": "tsx scripts/run-workspace-script.ts build",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:server": "npm run build:shared && npm run build --workspace=apps/web && npm run build --workspace=apps/api && npm run seed:e2e --workspace=apps/api && npm run start --workspace=apps/api",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "verify": "npm run check:eol && npm run build:shared && npm run typecheck && npm run lint && npm run format:check && npm run test:cov && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-no-secrets": "^1.0.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
