# Used by the Playwright E2E suite (e2e/) — the URL of the running app to
# test against. Defaults to the local production build served by apps/api
# (npm run e2e builds+starts it for you). Point this at a real/staging
# deployment to run the same suite against it instead.
E2E_BASE_URL=http://localhost:3000

# apps/api also needs its own .env (copy apps/api/.env.example) with at
# least JWT_SECRET set — required for the server the E2E suite starts. Also
# set ALLOWED_ORIGINS=http://localhost:3000 there (matching E2E_BASE_URL
# above) — otherwise the realtime WebSocket upgrade is rejected, since the
# default allowed origin is the Vite dev server's, not this one.
